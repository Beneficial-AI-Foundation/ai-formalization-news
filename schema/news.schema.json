{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Beneficial-AI-Foundation/ai-formalization-news/schema/news.schema.json",
  "title": "BAIF news item files",
  "description": "Shape of data/news.json, data/hidden.json and data/archive/YYYY-MM.json. Checked before every write.",
  "type": "object",
  "required": ["version", "items"],
  "properties": {
    "version": {"const": 1},
    "updated": {"type": ["string", "null"], "format": "date-time"},
    "month": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}
  },
  "additionalProperties": false,
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "type", "source", "source_id", "title", "url", "authors", "published", "fetched", "source_text", "summary", "score", "relevant"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^(arxiv|u):[A-Za-z0-9./\\-]+$"},
        "type": {"enum": ["paper", "lean", "news", "blog", "social"]},
        "source": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "url": {"type": "string", "pattern": "^https?://"},
        "authors": {"type": "array", "items": {"type": "string"}, "maxItems": 20},
        "published": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "fetched": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "source_text": {"type": "string", "maxLength": 600},
        "summary": {"type": ["string", "null"], "maxLength": 160},
        "score": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "relevant": {"type": ["boolean", "null"]},
        "hidden": {"const": true, "description": "Judged off topic by Claude, from a source that is not trusted: left out of news.json, search.json and the feed, and listed in hidden.json."}
      }
    }
  }
}
